# Azure OpenAI, used to turn a recognized sign sequence into an English sentence
# and to translate non-English speech into English.
OPENAI_API_KEY=your-azure-openai-key
OPENAI_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_GENERATOR_DEPLOYMENT=your-chat-deployment-name

# Optional. Ceiling on /translate-to-english calls, counted in Modal; 100 when unset.
# MAX_TRANSLATIONS=100

# Modal credentials for the sign-recognition service. Prefer `modal token new`,
# which writes these for you; set them here only if you cannot use the CLI.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Render API access for triggering and checking backend deploys (see DEPLOYMENT.md).
# Needed only to deploy the hosted API, not to run it locally.
# Create the key under Render Account Settings > API Keys.
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dah2qopt0dsc73ebk8r0

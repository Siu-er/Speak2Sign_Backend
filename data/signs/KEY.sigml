<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="key1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <tgt_motion>
      <changeposture/>
      <handconfig palmor="l"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>

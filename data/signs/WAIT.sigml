<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wait1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="o" second_extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="i"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>

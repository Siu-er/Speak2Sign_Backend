<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="call2">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="touch" location="chin"/>
  </sign_manual>
</hamgestural_sign>

</sigml>

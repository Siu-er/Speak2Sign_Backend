<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="drink1">
  <sign_manual>
    <handconfig handshape="cee12"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="tongue"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="u" palmor="l"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
